syntax = "v1"


type (
    SysTestAddRequest {
		Name  string  `json:"name,optional"`  // 名称
    }

    SysTestDelRequest {
		Id  int64  `path:"id"`  // 雪花算法ID
    }

    SysTestUpRequest {
		Id  int64  `json:"id"`  // 雪花算法ID
		Name  string  `json:"name,optional"`  // 名称      
    }


    SysTestListRequest {
		Current  int64  `form:"current,default=1,optional"`  // 页码
		PageSize  int64  `form:"page_size,default=10,optional"`  // 页数
		Name  string  `form:"name,optional"`  // 名称       
    }

    SysTestInfoRequest {
		Id  int64  `form:"id"`  // 雪花算法ID          
    }

)

@server(
    //声明当前service下所有路由需要jwt鉴权，且会自动生成包含jwt逻辑的代码
    jwt: Auth
    group: sysTest
)

service User {

    // 添加
    @handler SysTestAdd
    post /user/sysTest (SysTestAddRequest) returns (Response)

    // 删除
    @handler SysTestDel
    delete /user/sysTest/:id (SysTestDelRequest) returns (Response)

    // 更新
    @handler SysTestUp
    put /user/sysTest (SysTestUpRequest) returns (Response)

    // 分页查询
    @handler SysTestList
    get /user/sysTest (SysTestListRequest) returns (Response)

    // 查询详细信息
    @handler SysTestInfo
    get /user/sysTestInfo (SysTestInfoRequest) returns (Response)
}